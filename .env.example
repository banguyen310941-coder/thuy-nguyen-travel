# HappyGo Travel - Vercel environment template
# Add real values in Vercel Project Settings > Environment Variables.
# Never commit real secrets.

# Public URLs
# Use the stable Vercel production URL until happygo.vn is connected.
NEXT_PUBLIC_SITE_URL=https://happygo-travel.vercel.app
PUBLIC_SITE_URL=https://happygo-travel.vercel.app
# Optional only when using a separate external API. Same-origin /api is the default.
NEXT_PUBLIC_API_BASE_URL=

# Database and server security
DATABASE_URL=
AUTH_SECRET=
MIGRATION_SECRET=
# Required by protected Admin integration APIs. Generate a long random value.
ADMIN_API_KEY=

# Transactional / marketing email via Resend
RESEND_API_KEY=
EMAIL_FROM=HappyGo Travel <booking@happygo.vn>
EMAIL_REPLY_TO=info@happygo.vn
ADMIN_EMAIL=info@happygo.vn

# Google Drive server connection
# Preferred production mode: Google service account with Drive read-only scope.
# Share the HappyGo source folder directly with GOOGLE_SERVICE_ACCOUNT_EMAIL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Legacy fallback only if OAuth refresh-token flow is intentionally used.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Business contact
BUSINESS_HOTLINE=0969973949

# Optional integrations
# ZALO_OA_ACCESS_TOKEN=
# PAYMENT_WEBHOOK_SECRET=
# CRON_SECRET=
