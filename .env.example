# HappyGo Travel - Vercel environment template
# Add real values in Vercel Project Settings > Environment Variables.
# Never commit real secrets.

# Public URLs
# Leave NEXT_PUBLIC_SITE_URL blank for the first Vercel preview. Set it to
# https://happygo.vn only after the custom domain is connected.
NEXT_PUBLIC_SITE_URL=
# Optional external API. Leave blank when the feature does not use a separate API.
NEXT_PUBLIC_API_BASE_URL=
# Used by transactional email links. Set this to the actual Vercel production URL
# after the first deployment, then change it to https://happygo.vn after domain cutover.
PUBLIC_SITE_URL=

# Database and server security
DATABASE_URL=
AUTH_SECRET=
MIGRATION_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=HappyGo Travel <booking@happygo.vn>
EMAIL_REPLY_TO=info@happygo.vn
ADMIN_EMAIL=info@happygo.vn

# Business contact
BUSINESS_HOTLINE=0969973949

# Optional integrations
# ZALO_OA_ACCESS_TOKEN=
# PAYMENT_WEBHOOK_SECRET=
# CRON_SECRET=
