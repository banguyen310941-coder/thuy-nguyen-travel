# HappyGo Travel - production environment template
# GitHub Pages can leave server-only values empty. On Vercel configure these
# in Project Settings > Environment Variables; never commit real secrets.

# Optional external API. Leave empty when using same-origin Next.js /api routes.
NEXT_PUBLIC_API_BASE_URL=

# Production database (recommended: Vercel Postgres / Neon / Supabase Postgres)
DATABASE_URL=

# Server authentication secret, generate a long random value in Vercel.
AUTH_SECRET=

# Transactional and marketing email
RESEND_API_KEY=
EMAIL_FROM=HappyGo Travel <booking@happygo.vn>
ADMIN_EMAIL=info@happygo.vn

# Optional integrations for the 100% phase
# ZALO_OA_ACCESS_TOKEN=
# PAYMENT_WEBHOOK_SECRET=
# CRON_SECRET=
